# ==============================================================================
# VOXEL EARTH OBSERVATION PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in the values for your environment.
# NEVER commit your actual '.env' file containing real secret keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STAGE 0: NATURAL LANGUAGE QUERY COMPILER & LLM PROVIDERS
# ------------------------------------------------------------------------------
# Primary LLM Provider: Google Gemini (Recommended: gemini-1.5-flash)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary Fallback LLM Providers (Optional)
# If GEMINI_API_KEY is not set or hits rate limits, Voxel falls back automatically:
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. STAGE 1: GEOSPATIAL DATA INGESTION & COPERNICUS SERVICES
# ------------------------------------------------------------------------------
# Copernicus Data Space Ecosystem (CDSE) STAC API URL (Default Public Endpoint)
COPERNICUS_STAC_URL=https://sh.dataspace.copernicus.eu/api/catalogs/stac

# Optional CDSE OAuth Credentials for direct S3 bucket downloads
COPERNICUS_CDSE_CLIENT_ID=your_cdse_client_id_here
COPERNICUS_CDSE_CLIENT_SECRET=your_cdse_client_secret_here

# Optional Google Maps Platform Geocoding API Key (Fallback for Nominatim)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 3. DASHBOARD & MAP VISUALIZATION (Streamlit / Folium / Mapbox)
# ------------------------------------------------------------------------------
# Mapbox Access Token for high-resolution satellite basemaps & 3D terrain
MAPBOX_API_KEY=your_mapbox_api_key_here

# ------------------------------------------------------------------------------
# 4. MLOPS & CONVERGENCE TRACKING (Weights & Biases)
# ------------------------------------------------------------------------------
# Weights & Biases API Key for logging WOA search metrics & model training
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=voxel-earth-observation

# ------------------------------------------------------------------------------
# 5. PLATFORM RUNTIME SETTINGS
# ------------------------------------------------------------------------------
VOXEL_ENV=development
LOG_LEVEL=INFO
